{
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "orders-route": {
        "ClusterId": "retotienda-api-cluster",
        "Match": {
          "Path": "/orders/{**catch-all}"
        }
      },
      "swagger-route": {
        "ClusterId": "retotienda-api-cluster",
        "Match": {
          "Path": "/swagger/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "retotienda-api-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://retotienda-api:8080/"
          }
        }
      }
    }
  }
}